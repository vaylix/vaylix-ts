{
  "name": "@vaylix/client",
  "version": "0.1.2",
  "description": "Official TypeScript client for the Vaylix database.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaylix/vaylix-ts.git"
  },
  "keywords": [
    "vaylix",
    "database",
    "db",
    "client",
    "sdk",
    "typescript",
    "nodejs",
    "tcp",
    "kv",
    "key-value"
  ],
  "homepage": "https://vaylix.github.io",
  "bugs": {
    "url": "https://github.com/vaylix/vaylix-ts/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx test/integration.live.ts",
    "prepack": "node ../../scripts/sync-package-readme.mjs"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "crc-32": "^1.2.2",
    "uuid": "^14.0.0"
  }
}
