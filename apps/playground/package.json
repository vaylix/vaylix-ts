{
  "name": "@vaylix/playground",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @vaylix/client && concurrently -k -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build -w @vaylix/client && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run build -w @vaylix/client && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --eval \"console.log('no tests')\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/cors": "^11.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@vaylix/client": "0.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "dotenv": "17.4.2",
    "fastify": "^5.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
